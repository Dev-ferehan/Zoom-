<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Zoom Clone</title>
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.5.1/dist/jquery.slim.min.js" integrity="sha384-DfXdz2htPH0lsSSs5nCTpuj/zy4C+OGpamoFVy38MVBnE+IbbVYUew+OrCXaRkfj" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-Fy6S3B9q64WdZWQUiU+q4/2Lc9npb8tCaSX9FK7E8HnRr0Jz8D6OP9dO5Vg3Q9ct" crossorigin="anonymous"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css"
        integrity="sha384-xOolHFLEh07PJGoPkLv1IbcEPTNtaed2xpHsD9ESMhqIYd0nLMwNLD69Npy4HI+N" crossorigin="anonymous">
    
    
    <script src="https://kit.fontawesome.com/554c71b5bc.js" crossorigin="anonymous"></script>

    <script>
        const ROOM_ID = '<%= roomId %>';
    </script>

    <script src="https://unpkg.com/peerjs@1.5.4/dist/peerjs.min.js" defer></script>
    <script src="/socket.io/socket.io.js" defer></script>
    <script src="script.js" defer></script>
    <link rel="stylesheet" href="style.css">
    
    
</head>

<body>
    <div class="main">
        <div class="main_left">
            <div class="main_videos">
                <div id="video_container" class="row no-gutters justify-content-center align-content-center">

                </div>
            </div>

            <div class="main_controls">
                <div class="main_controls_block">
                    <div class="main_controls_button">
                        <i class="fa-solid fa-users"></i>
                        <span>Manage Participants</span>
                    </div>
                    <div onclick="setPlayVideo()"  class="main_controls_button main_video_button">
                        <i class="fa-solid fa-video"></i>
                        <span>Stop Video</span>
                    </div>
                    <div onclick="setMuteUnmute()"  class="main_controls_button main_mute_button">
                        <i class="fa-solid fa-microphone"></i>
                        <span>Mute</span>
                    </div>
                </div>

                <div class="main_controls_block">
                    <div class="main_controls_button phone_disconnect">
                        <i class="fa-solid fa-phone-slash"></i>
                    </div>
                </div>

                <div class="main_controls_block">
                    <div class="main_controls_button">
                        <i class="fa-solid fa-arrow-up-from-bracket"></i>
                        <span>Share</span>
                    </div>
                    <div class="main_controls_button">
                        <i class="fa-solid fa-user-plus"></i>
                        <span>Invite</span>
                    </div>
                    
                    <div class="main_controls_button" id="chat_toggle_btn">
                        <i class="fa-solid fa-comment"></i>
                        <span class="chat_control">Chat</span>
                    </div> 

                    <div class="main_controls_block">

                    </div>
                    <div onclick="endMetting()" class="main_controls_button leave_meeting">
                        <span>End Meeting</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="main_right" id="chat_section">
            <div class="main_header">
                <h6 class="text-center pt-3">Chat Room</h6>
            </div>
            <div class="main_chat_window">
                <ul class="messages list-unstyled" id="all_messages">
                    
                    </ul>
            </div>
            <div class="main_message_container">
                <input id="chat_message" type="text" placeholder="Type message here...">
            
            </div>
        </div>
    </div>

    <script>
        const chatBtn = document.getElementById('chat_toggle_btn');
        const chatSection = document.getElementById('chat_section');

        chatBtn.addEventListener('click', () => {
     
            chatSection.classList.toggle('active');
        });
    </script>
</body>

</html>